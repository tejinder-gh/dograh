{
  "name": "@dograh/business-api",
  "version": "1.0.0",
  "description": "AI Calling Agent OS Business Extension Service for Dograh",
  "private": true,
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "test:unit": "bun test src/tests/unit",
    "test:integration": "bun test src/tests/integration",
    "migrate": "bun run src/config/migrator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
