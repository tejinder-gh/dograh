# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Required Neon PostgreSQL connection string.
# Dedicated database "ai_calling_agent_os" is strictly required. Targeting second-brain or neondb is forbidden.
# Example: postgresql://username:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/ai_calling_agent_os?sslmode=require
DATABASE_URL=""

# AUTH_SECRET: Mandatory 256-bit secret used to cryptographically sign and verify tenant JWT tokens.
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# ENCRYPTION_MASTER_KEY: Mandatory 256-bit encryption key used to encrypt provider credentials (Stripe, Twilio, etc.) with AES-256-GCM.
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""

