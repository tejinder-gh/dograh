BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_NODE_ENV=development

# Base URL of the user-facing app (e.g. https://equity.skillcorner.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Business Extension Service (:4000)
BUSINESS_API_URL=http://127.0.0.1:4000
BUSINESS_EXT_SECRET=your_32_character_high_entropy_secret_here
ACUITY_DEPLOYMENT_ID=default

# Subdomain Cookie Configuration (e.g. .skillcorner.com for *.skillcorner.com SSO)
# Leave unset in local development to bind cookies to exact host.
# COOKIE_DOMAIN=.skillcorner.com

# Product & Ecosystem Branding
NEXT_PUBLIC_PRODUCT_NAME="Skill Corner Equity"
NEXT_PUBLIC_PRODUCT_SHORT_NAME="Equity"
NEXT_PUBLIC_PRODUCT_DESCRIPTION="AI Voice Calling Agent OS — Enterprise Voice Workflows & Telephony Automation"
NEXT_PUBLIC_SUPPORT_URL="https://skillcorner.com/contact"
NEXT_PUBLIC_DOCS_URL="https://skillcorner.com/digital-services/ai-receptionist"

# Telemetry and Tracking (optional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_EVENT_BANNER=0
